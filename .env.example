# Obtain a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Set a Gemini model ID available to your API project.
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
LEXIRAG_DATA_DIR=data
LEXIRAG_PORT=8080
MAX_UPLOAD_MB=30
MAX_PDF_PAGES=1000
CHUNK_SIZE=900
CHUNK_OVERLAP=120
LLM_CONTEXT_CHARS=24000
# RapidOCR + ONNX is automatic and bundled; no OCR environment settings needed.
# Optional fallback ONLY if Tesseract is already installed:
# OCR_LANGUAGE=eng
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata

